{
  "RateLimiting": {
    "Global": {
      "Authenticated": {
        "TokenLimit": 3,
        "TokensPerPeriod": 3,
        "ReplenishmentPeriodSeconds": 60
      },
      "Anonymous": {
        "TokenLimit": 3,
        "TokensPerPeriod": 3,
        "ReplenishmentPeriodSeconds": 60
      }
    },
    "Login": {
      "PermitLimit": 2,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Reports": {
      "ConcurrencyLimit": 1,
      "TokenLimit": 3,
      "TokensPerPeriod": 3,
      "ReplenishmentPeriodSeconds": 60
    },
    "Public": {
      "TokenLimit": 3,
      "TokensPerPeriod": 3,
      "ReplenishmentPeriodSeconds": 60
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownIPNetworks": []
  }
}
