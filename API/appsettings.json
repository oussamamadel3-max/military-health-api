{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Key": "",
    "Issuer": "https://localhost:4200/defdev",
    "Audience": "519e5963-e33r-4223-8935-87409bn9adf7",
    "ExpirationInMinutes": 30,
    "RefreshTokenExpirationInDays": 30
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://archive.defdev-sy.com"
    ]
  },
  "FileStorage": {
    "RootPath": "storage",
    "UploadPath": "uploads",
    "MaxFileSizeInMB": 50,
    "AllowArchives": false,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx"
    ]
  },
  "RateLimiting": {
    "Global": {
      "Authenticated": {
        "TokenLimit": 120,
        "TokensPerPeriod": 60,
        "ReplenishmentPeriodSeconds": 60
      },
      "Anonymous": {
        "TokenLimit": 30,
        "TokensPerPeriod": 15,
        "ReplenishmentPeriodSeconds": 60
      }
    },
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Refresh": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6
    },
    "Reports": {
      "ConcurrencyLimit": 2,
      "TokenLimit": 10,
      "TokensPerPeriod": 5,
      "ReplenishmentPeriodSeconds": 60
    },
    "Public": {
      "TokenLimit": 30,
      "TokensPerPeriod": 15,
      "ReplenishmentPeriodSeconds": 60
    }
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownIPNetworks": []
  },
  "LoginLockout": {
    "MaxFailedAccessAttempts": 5,
    "DurationsSeconds": [30, 60, 120, 300, 900],
    "TierResetAfterSeconds": 86400
  },
  "ClinicWorkspace": {
    "EditLockTimeoutMinutes": 30
  }
}
